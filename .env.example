# Direct sending requires the sender/key plus configured Turnstile OR verified Vercel WAF.
# Otherwise the accessible form prepares an email draft, and never claims it was sent.
RESEND_API_KEY=
QUOTE_FROM_EMAIL=Saeed Contracting <quotes@notifications.saeedcontracting.ca>
# Set true ONLY after the documented Vercel quote rate-limit rule is published and tested.
QUOTE_FIREWALL_ENABLED=false
# Optional additional challenge; both values must exist to use it.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional Search Console verification. No placeholder tag is emitted.
GOOGLE_SITE_VERIFICATION=
# Reserved for a future consent-aware analytics integration; currently not loaded.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

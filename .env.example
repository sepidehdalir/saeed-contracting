# Direct submission is enabled only when all four email/security values are configured.
# Otherwise the accessible form prepares an email draft, and never claims it was sent.
RESEND_API_KEY=
QUOTE_FROM_EMAIL=Saeed Contracting <quotes@notifications.saeedcontracting.ca>
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional Search Console verification. No placeholder tag is emitted.
GOOGLE_SITE_VERIFICATION=
# Reserved for a future consent-aware analytics integration; currently not loaded.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
